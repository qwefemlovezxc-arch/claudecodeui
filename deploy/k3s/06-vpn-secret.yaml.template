# Template — DO NOT commit the real secret. Copy to 06-vpn-secret.yaml
# and paste the AmneziaWG config from nl.conf into wg0.conf (preserve
# indentation exactly — bash heredoc-style).
#
# kubectl create secret generic claudecode-vpn \
#   --namespace=claudecode \
#   --from-file=wg0.conf=/Users/macbook/Documents/nl.conf
#
# is the simpler way to produce this without pasting into YAML.
#
# The real file (06-vpn-secret.yaml) is gitignored via .gitignore.

apiVersion: v1
kind: Secret
metadata:
  name: claudecode-vpn
  namespace: claudecode
type: Opaque
stringData:
  wg0.conf: |
    [Interface]
    Address = 100.xxx.xxx.xxx/32
    DNS = 100.64.0.1, 8.8.4.4
    PrivateKey = REPLACE_FROM_nl_conf
    Jc = 3
    Jmin = 10
    Jmax = 50
    S1 = 20
    S2 = 145
    H1 = 0000000000
    H2 = 0000000000
    H3 = 0000000000
    H4 = 0000000000
    I1 = REPLACE_FROM_nl_conf

    [Peer]
    PublicKey = REPLACE_FROM_nl_conf
    PresharedKey = REPLACE_FROM_nl_conf
    AllowedIPs = 0.0.0.0/0, ::/0
    Endpoint = 89.xxx.xxx.xxx:45649
    PersistentKeepalive = 25
